# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/ctransit?sslmode=disable
DATABASE_URL_POOLED=postgresql://user:password@localhost:5432/ctransit?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Auth & Secrets
ADMIN_API_SECRET=your_admin_api_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
OTP_SECRET=your_otp_secret_key_here
ALLOWED_EMAIL_DOMAIN=@covenantuniversity.edu.ng

# Mail Configuration
MAIL_USER=notifications@ctransit.me
MAIL_PASSWORD=your_mail_password_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=your_payment_secret_key

# MQTT Bridge Microservice
MQTT_INTERNAL_URL=http://localhost:4000
MQTT_INTERNAL_SECRET=your_mqtt_internal_secret

# Ledger
BASE_FARE=150
ADMIN_SEED_PASSWORD=ctransit@dev2
